# DATABASE
DATABASE_URL=sqlite:///./data/joao_ramos_consultas_database.db
TEST_DATABASE_URL=sqlite:///./data/test_database.db

# AUTH
ADMIN_USERNAME="INSIRA UM NOME DE USUARIO ADMIN"
ADMIN_PASSWORD="INSIRA UMA SENHA PARA O USUARIO ADMIN"

SYSTEM_USER_ID=1

JWT_ENCODE_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
USER_JWT_EXPIRES_IN_MINUTES=720
MFA_EXPIRE_MINUTES=2

# M2M CLIENTS
LAB_CLIENT_ID=laboratorio_parceiro_id
LAB_CLIENT_SECRET="INSIRA AQUI O SECRET DO CLIENTE"

LAB_REQUIRED_SCOPE=lab_access
LAB_JWT_EXPIRES_IN_MINUTES=720

# LOGS
LOG_LEVEL_STDOUT=DEBUG
LOG_LEVEL_FILE=INFO
LOG_FILE_PATH=./data/joao_ramos_app.log
TEST_LOG_FILE_PATH=./data/joao_ramos_app.test.log

# LOGIN RATE LIMITING
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPTS_TIMESPAN_MINUTES=10

# CORS CONFIG
ALLOWED_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

# ENVIRONMENT
IS_DEV=True
IS_TEST=false
